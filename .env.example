# ---- Database (Supabase / PostgreSQL) ----
# Use the Supabase "Transaction" pooler URL (host ...pooler.supabase.com, port 6543)
# and append ?pgbouncer=true for Prisma. Direct 5432 connections are limited.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# ---- Auth (Auth.js / NextAuth v5) ----
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-long-random-string"
# Public base URL of the app (e.g. https://lms.varun101.dev in production)
AUTH_URL="http://localhost:3000"

# ---- Zoom (Server-to-Server OAuth app) ----
ZOOM_ACCOUNT_ID=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""
# Secret token from the Zoom webhook config (used to verify webhook signatures)
ZOOM_WEBHOOK_SECRET_TOKEN=""

# ---- Object storage (AWS S3) ----
# S3 is configured PER-ORGANIZATION inside the app (Platform settings: bucket,
# region, access key, secret, public URL) and stored encrypted in the database.
# There are no S3 environment variables — leave the org's "endpoint" field blank
# to use real AWS S3 (an endpoint is only set for MinIO/S3-compatible services).

# ---- Redis (queue / cache) ----
REDIS_URL="redis://localhost:6379"

# ---- Email (SMTP) ----
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Verdant LMS <no-reply@verdant.local>"
